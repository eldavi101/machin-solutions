---
import { site, callHref, real } from '../config/site';

export interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const nav = [
  { href: '/pergolas/', label: 'Pergolas' },
  { href: '/tiki-huts/', label: 'Tiki Huts' },
  { href: '/outdoor-living/', label: 'Outdoor Living' },
  { href: '/gallery/', label: 'Our Work' },
  { href: '/service-areas/', label: 'Service Areas' },
  { href: '/about/', label: 'About' },
];

const isCurrent = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
const phone = real(site.phone);
---

<header class="site-header">
  <div class="shell header-inner">
    {/* No aria-label: the visible text is the accessible name. An aria-label that
        does not contain the visible text breaks WCAG 2.5.3 (Label in Name) and
        leaves voice-control users unable to say what they can read. */}
    <a href="/" class="brand">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="30" height="30" focusable="false">
          <path d="M2 12 16 4l14 8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" />
          <path d="M6 13v15M16 13v15M26 13v15" fill="none" stroke="currentColor" stroke-width="2.2" />
          <path d="M2 13h28" fill="none" stroke="currentColor" stroke-width="2.2" />
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">Machin Solutions</span>
        <span class="brand-sub">Pergolas &amp; Tiki Huts</span>
      </span>
    </a>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-nav-toggle
    >
      <span class="nav-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="nav-toggle-label">Menu</span>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="Primary" data-nav>
      <ul class="nav-list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav-cta">
        <a class="btn btn-ghost nav-call" href={callHref()}>
          {phone ? phone : <span class="placeholder-token">[PHONE_NUMBER]</span>}
        </a>
        <a class="btn btn-primary" href="/contact/">Get a Free Estimate</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--sand-50) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    min-height: 4.5rem;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    margin-right: auto;
    padding-block: 0.5rem;
  }
  .brand-mark { color: var(--accent); display: flex; }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.16rem;
    letter-spacing: -0.015em;
  }
  .brand-sub {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    font-weight: 600;
  }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.45rem 0.85rem;
    background: transparent;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.92rem;
    cursor: pointer;
  }
  .nav-toggle-bars { display: grid; gap: 4px; width: 17px; }
  .nav-toggle-bars span {
    display: block;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bars span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bars span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bars span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .primary-nav {
    display: none;
    width: 100%;
    padding-block: var(--space-s) var(--space-m);
    border-top: 1px solid var(--line);
  }
  .primary-nav[data-open] { display: block; }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-s);
    display: grid;
    gap: 0.15rem;
  }
  .nav-list a {
    display: block;
    padding: 0.7rem 0.25rem;
    text-decoration: none;
    font-weight: 550;
    border-bottom: 1px solid var(--line);
  }
  .nav-list a[aria-current='page'] { color: var(--accent); }

  .nav-cta { display: grid; gap: 0.5rem; }
  .nav-call { font-variant-numeric: tabular-nums; }

  @media (min-width: 62rem) {
    .nav-toggle { display: none; }
    .primary-nav {
      display: flex;
      align-items: center;
      gap: var(--space-m);
      width: auto;
      padding: 0;
      border-top: 0;
    }
    .nav-list {
      display: flex;
      align-items: center;
      gap: 1.35rem;
      margin: 0;
    }
    .nav-list a {
      padding: 0.35rem 0;
      border-bottom: 2px solid transparent;
      font-size: 0.96rem;
    }
    .nav-list a:hover { border-bottom-color: var(--line-strong); }
    .nav-list a[aria-current='page'] { border-bottom-color: var(--accent); }
    .nav-cta { display: flex; align-items: center; gap: 0.6rem; }
    .nav-cta .btn { min-height: 2.7rem; padding: 0.5rem 1.05rem; font-size: 0.94rem; }
    .nav-call { display: none; }
  }

  @media (min-width: 76rem) {
    .nav-call { display: inline-flex; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      if (open) nav.setAttribute('data-open', '');
      else nav.removeAttribute('data-open');
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // The desktop layout shows the nav unconditionally; drop the mobile state so it
    // never gets stuck open when someone rotates a tablet.
    const wide = window.matchMedia('(min-width: 62rem)');
    wide.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
