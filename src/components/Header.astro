---
import { site, callHref, phoneLabel } from '../config/site';
import { defaultLang, langNames, localizePath, stripLang, type Lang } from '../i18n';
import { counterpart } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

export interface Props {
  /** Path of the current page, language prefix included. */
  currentPath: string;
  lang?: Lang;
  /** Off on noindex pages, where the counterpart URL is not a real address. */
  showLangSwitch?: boolean;
}

const { currentPath, lang = defaultLang, showLangSwitch = true } = Astro.props;
const t = useTranslations(lang);

/** Nav hrefs are written as logical paths and localised once, here. */
const L = (path: string) => localizePath(path, lang);

const nav = [
  { href: L('/pergolas/'), label: t('nav.pergolas') },
  { href: L('/tiki-huts/'), label: t('nav.tikiHuts') },
  { href: L('/outdoor-living/'), label: t('nav.outdoorLiving') },
  { href: L('/gallery/'), label: t('nav.gallery') },
  { href: L('/service-areas/'), label: t('nav.serviceAreas') },
  { href: L('/about/'), label: t('nav.about') },
];

const logical = stripLang(currentPath);
const isCurrent = (href: string) => currentPath === href || (href !== L('/') && currentPath.startsWith(href));
const phone = phoneLabel();

// The switcher points at THIS page in the other language, not at the other home
// page. Sending someone reading /pergolas/aluminum/ to /es/ is the classic i18n
// mistake and it loses the visitor.
const otherLang: Lang = lang === 'en' ? 'es' : 'en';
// null while this page has no counterpart yet. A switcher that links to a page
// nobody has written is a 404 in the header, which is the worst place for one.
const otherHref = showLangSwitch ? counterpart(logical, otherLang) : null;
---

<header class="site-header">
  <div class="shell header-inner">
    {/* No aria-label: the visible text is the accessible name. An aria-label that
        does not contain the visible text breaks WCAG 2.5.3 (Label in Name) and
        leaves voice-control users unable to say what they can read. */}
    <a href={L('/')} class="brand">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="30" height="30" focusable="false">
          <path d="M2 12 16 4l14 8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" />
          <path d="M6 13v15M16 13v15M26 13v15" fill="none" stroke="currentColor" stroke-width="2.2" />
          <path d="M2 13h28" fill="none" stroke="currentColor" stroke-width="2.2" />
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">Machin Solutions</span>
        <span class="brand-sub">Pergolas &amp; Tiki Huts</span>
      </span>
    </a>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-nav-toggle
    >
      <span class="nav-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="nav-toggle-label">{t('nav.menu')}</span>
    </button>

    {/* Language switcher. Sits outside the collapsible nav on purpose: it has to be
        visible on a phone without opening the menu first. Two states, both always
        shown, so it reads as a switch rather than as a link to somewhere new. */}
{
      otherHref && (
        <div class="lang-switch" role="group" aria-label={t('lang.label')}>
          <span class="lang-current" aria-current="true">{lang === 'en' ? 'EN' : 'ES'}</span>
          <a class="lang-other" href={otherHref} hreflang={otherLang} lang={otherLang}>
            <span aria-hidden="true">{otherLang === 'en' ? 'EN' : 'ES'}</span>
            <span class="visually-hidden">{langNames[otherLang]}</span>
          </a>
        </div>
      )
    }

    <nav id="primary-nav" class="primary-nav" aria-label={t('nav.primary')} data-nav>
      <ul class="nav-list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav-cta">
        <a class="btn btn-ghost nav-call" href={callHref()}>
          {phone ? phone : <span class="placeholder-token">[PHONE_NUMBER]</span>}
        </a>
        <a class="btn btn-primary" href={L('/contact/')}>{t('cta.freeEstimate')}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--sand-50) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    min-height: 4.5rem;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    margin-right: auto;
    padding-block: 0.5rem;
  }
  .brand-mark { color: var(--accent); display: flex; }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.16rem;
    letter-spacing: -0.015em;
  }
  .brand-sub {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    font-weight: 600;
  }

  /* Two-state switch: the active language is a solid chip, the other is a link.
     Both visible at all times so it reads as a toggle, and it never collapses into
     the mobile menu — a Spanish speaker must find it without opening anything. */
  .lang-switch {
    display: inline-flex;
    align-items: stretch;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-right: 0.15rem;
  }
  .lang-current,
  .lang-other {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.6rem;
    min-height: 2.6rem;
    padding: 0 0.55rem;
  }
  .lang-current {
    background: var(--graphite-900);
    color: #fff;
  }
  .lang-other {
    text-decoration: none;
    color: var(--ink-soft);
    background: transparent;
  }
  .lang-other:hover,
  .lang-other:focus-visible {
    background: var(--sand-100);
    color: var(--ink);
  }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.45rem 0.85rem;
    background: transparent;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.92rem;
    cursor: pointer;
  }
  .nav-toggle-bars { display: grid; gap: 4px; width: 17px; }
  .nav-toggle-bars span {
    display: block;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bars span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bars span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bars span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .primary-nav {
    display: none;
    width: 100%;
    padding-block: var(--space-s) var(--space-m);
    border-top: 1px solid var(--line);
  }
  .primary-nav[data-open] { display: block; }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-s);
    display: grid;
    gap: 0.15rem;
  }
  .nav-list a {
    display: block;
    padding: 0.7rem 0.25rem;
    text-decoration: none;
    font-weight: 550;
    border-bottom: 1px solid var(--line);
  }
  .nav-list a[aria-current='page'] { color: var(--accent); }

  .nav-cta { display: grid; gap: 0.5rem; }
  .nav-call { font-variant-numeric: tabular-nums; }

  @media (min-width: 62rem) {
    .nav-toggle { display: none; }
    .primary-nav {
      display: flex;
      align-items: center;
      gap: var(--space-m);
      width: auto;
      padding: 0;
      border-top: 0;
    }
    .nav-list {
      display: flex;
      align-items: center;
      gap: 1.35rem;
      margin: 0;
    }
    .nav-list a {
      padding: 0.35rem 0;
      border-bottom: 2px solid transparent;
      font-size: 0.96rem;
    }
    .nav-list a:hover { border-bottom-color: var(--line-strong); }
    .nav-list a[aria-current='page'] { border-bottom-color: var(--accent); }
    .nav-cta { display: flex; align-items: center; gap: 0.6rem; }
    .nav-cta .btn { min-height: 2.7rem; padding: 0.5rem 1.05rem; font-size: 0.94rem; }
    .nav-call { display: none; }
  }

  @media (min-width: 76rem) {
    .nav-call { display: inline-flex; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      if (open) nav.setAttribute('data-open', '');
      else nav.removeAttribute('data-open');
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // The desktop layout shows the nav unconditionally; drop the mobile state so it
    // never gets stuck open when someone rotates a tablet.
    const wide = window.matchMedia('(min-width: 62rem)');
    wide.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
