---
import { areasByCounty, landingAreas } from '../data/areas';

import { defaultLang, localizePath, type Lang } from '../i18n';
import { useTranslations } from '../i18n/ui';

export interface Props {
  lang?: Lang;
  eyebrow?: string;
  title?: string;
  intro?: string;
  /** Show only the cities with their own landing page. */
  featuredOnly?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { lang = defaultLang, ...rest } = Astro.props;
const t = useTranslations(lang);
const {
  eyebrow = t('footer.serviceAreas'),
  title = t('areas.whereWeBuild'),
  intro,
  featuredOnly = false,
  headingLevel = 'h2',
} = rest;

const Heading = headingLevel;
---

<section class="section section-sand">
  <div class="shell">
    <div class="section-head">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <Heading>{title}</Heading>
      {intro && <p class="lede" style="margin-top:var(--space-s)">{intro}</p>}
    </div>

    {
      featuredOnly ? (
        <ul class="featured-areas">
          {landingAreas.map((area) => (
            <li>
              <a href={localizePath(area.landing, lang)} class="area-card">
                <span class="area-name">{area.name}</span>
                <span class="area-note">{lang === 'es' ? area.noteEs : area.note}</span>
                <span class="area-cta" aria-hidden="true">
                  Pergolas in {area.name} →
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="county-grid">
          {areasByCounty.map((group) => (
            <div class="county">
              <h3 class="county-name">{group.county} County</h3>
              <ul class="county-list">
                {group.areas.map((area) => (
                  <li>
                    {area.landing ? <a href={localizePath(area.landing, lang)}>{area.name}</a> : <span>{area.name}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .featured-areas {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  .area-card {
    display: grid;
    gap: 0.4rem;
    height: 100%;
    padding: var(--space-m);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }
  .area-card:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .area-name { font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; }
  .area-note { font-size: 0.92rem; color: var(--ink-soft); }
  .area-cta { margin-top: auto; padding-top: 0.4rem; font-size: 0.88rem; font-weight: 650; color: var(--accent); }

  .county-grid {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .county-name {
    font-size: var(--step-1);
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--line-strong);
  }
  .county-list {
    margin-top: var(--space-s);
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
    font-size: 0.97rem;
  }
  .county-list a { font-weight: 600; }
  .county-list span { color: var(--ink-soft); }
</style>
