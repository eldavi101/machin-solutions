---
import { site, callHref, emailHref, real, phoneLabel, phoneAltLabel, callAltHref, emailAltHref } from '../config/site';
import { landingAreas } from '../data/areas';
import { defaultLang, localizePath, type Lang } from '../i18n';
import { useTranslations } from '../i18n/ui';

export interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const L = (path: string) => localizePath(path, lang);

const year = new Date().getFullYear();
const phone = phoneLabel();
const email = real(site.email);
const mailto = emailHref();
const phoneAlt = phoneAltLabel();
const callAlt = callAltHref();
const emailAlt = real(site.emailAlt);
const mailtoAlt = emailAltHref();
const licence = real(site.licenseNumber);

const columns = [
  {
    title: t('footer.pergolas'),
    links: [
      { href: L('/pergolas/'), label: t('footer.pergolasOverview') },
      { href: L('/pergolas/custom/'), label: t('footer.customPergolas') },
      { href: L('/pergolas/aluminum/'), label: t('footer.aluminumPergolas') },
      { href: L('/pergolas/wood/'), label: t('footer.woodPergolas') },
      { href: L('/pergolas/installation/'), label: t('footer.pergolaInstallation') },
    ],
  },
  {
    title: t('nav.tikiHuts'),
    links: [
      { href: L('/tiki-huts/'), label: t('footer.tikiOverview') },
      { href: L('/tiki-huts/chickee-huts/'), label: t('footer.chickeeHuts') },
      { href: L('/tiki-huts/construction/'), label: t('footer.tikiConstruction') },
      { href: L('/outdoor-living/'), label: t('footer.outdoorStructures') },
    ],
  },
  {
    title: t('footer.company'),
    links: [
      { href: L('/gallery/'), label: t('footer.ourWork') },
      { href: L('/about/'), label: t('footer.about') },
      { href: L('/service-areas/'), label: t('footer.serviceAreas') },
      { href: L('/faq/'), label: t('footer.faq') },
      { href: L('/contact/'), label: t('cta.requestQuote') },
    ],
  },
];
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-top">
      <div class="footer-brand">
        <p class="footer-name">Machin Solutions</p>
        <p class="footer-tag">{t('footer.tagline')}</p>
        <div class="footer-contact">
          <a class="btn btn-primary" href={L('/contact/')}>{t('cta.freeEstimate')}</a>
          <a class="footer-line" href={callHref()}>
            <span class="footer-label">{t('cta.call')}</span>
            {phone ? phone : <span class="placeholder-token">[PHONE_NUMBER]</span>}
          </a>
          {
            phoneAlt && callAlt && (
              <a class="footer-line" href={callAlt}>
                <span class="footer-label">{t('cta.or')}</span>
                {phoneAlt}
              </a>
            )
          }
          {
            mailto ? (
              <a class="footer-line" href={mailto}>
                <span class="footer-label">{t('cta.email')}</span>
                {email}
              </a>
            ) : (
              <span class="footer-line">
                <span class="footer-label">{t('cta.email')}</span>
                <span class="placeholder-token">[EMAIL]</span>
              </span>
            )
          }
          {
            emailAlt && mailtoAlt && (
              <a class="footer-line" href={mailtoAlt}>
                <span class="footer-label">{t('cta.or')}</span>
                {emailAlt}
              </a>
            )
          }
        </div>
      </div>

      <nav class="footer-nav" aria-label={t('footer.label')}>
        {
          columns.map((column) => (
            <div class="footer-col">
              <h2 class="footer-col-title">{column.title}</h2>
              <ul>
                {column.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="footer-areas">
      <h2 class="footer-col-title">{t('footer.popularAreas')}</h2>
      <ul class="area-links">
        {
          landingAreas.map((area) => (
            <li>
              <a href={L(area.landing)}>{`${t('footer.pergolasIn')} ${area.name}`}</a>
            </li>
          ))
        }
        <li><a href={L('/miami-tiki-huts/')}>{`${t('footer.tikiHutsIn')} Miami`}</a></li>
        <li><a href={L('/service-areas/')}>{t('footer.allAreas')}</a></li>
      </ul>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} Machin Solutions. {t('footer.rights')}</p>
      <p class="footer-meta">
        {
          licence ? (
            <span>{t('footer.licence')} {licence}</span>
          ) : (
            <span>
              {t('footer.licence')} <span class="placeholder-token">[LICENSE_NUMBER]</span>
            </span>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{t('footer.serving')}</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--graphite-950);
    color: var(--ink-inverse-soft);
    padding-block: var(--space-2xl) var(--space-l);
    margin-top: var(--space-2xl);
  }

  .footer-top {
    display: grid;
    gap: var(--space-xl);
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    color: var(--ink-inverse);
    letter-spacing: -0.015em;
  }
  .footer-tag { margin-top: var(--space-xs); max-width: 34ch; }

  .footer-contact {
    margin-top: var(--space-m);
    display: grid;
    gap: 0.7rem;
    justify-items: start;
  }
  .footer-line {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--ink-inverse);
    text-decoration: none;
    font-weight: 600;
  }
  .footer-line:hover { text-decoration: underline; }
  .footer-label {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    /* Not --ink-faint: that token is tuned for light grounds and only reaches
       3.6:1 against the near-black footer. */
    color: #8f938b;
    font-weight: 650;
    min-width: 3.2rem;
  }

  .footer-nav {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
  }
  .footer-col-title {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--teak-400);
    margin-bottom: 0.8rem;
  }
  .footer-nav ul, .area-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-nav li + li { margin-top: 0.5rem; }
  .footer-nav a, .area-links a {
    display: inline-block;
    color: var(--ink-inverse-soft);
    text-decoration: none;
    font-size: 0.95rem;
    padding-block: 0.15rem;
  }
  .footer-nav a:hover, .area-links a:hover { color: var(--ink-inverse); text-decoration: underline; }

  .footer-areas {
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: 1px solid color-mix(in srgb, var(--ink-inverse) 14%, transparent);
  }
  .area-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.35rem;
  }

  .footer-bottom {
    margin-top: var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid color-mix(in srgb, var(--ink-inverse) 14%, transparent);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem var(--space-m);
    justify-content: space-between;
    font-size: 0.87rem;
  }
  .footer-meta { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }

  @media (min-width: 56rem) {
    .footer-top { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.55fr); gap: var(--space-2xl); }
  }
</style>
