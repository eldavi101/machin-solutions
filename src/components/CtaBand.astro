---
import { callHref, phoneLabel } from '../config/site';

import { defaultLang, localizePath, type Lang } from '../i18n';
import { useTranslations } from '../i18n/ui';

export interface Props {
  lang?: Lang;
  title?: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  headingLevel?: 'h2' | 'h3';
}

const { lang = defaultLang, ...rest } = Astro.props;
const t = useTranslations(lang);
const {
  title = t('cta.band.title'),
  body = t('cta.band.body'),
  primaryLabel = t('cta.freeEstimate'),
  primaryHref = localizePath('/contact/', lang),
  secondaryLabel,
  secondaryHref,
  headingLevel = 'h2',
} = rest;

const Heading = headingLevel;
const phone = phoneLabel();
const fallbackSecondaryLabel = phone ? `Call ${phone}` : 'Call us';
---

<section class="cta-band section-dark">
  <div class="shell cta-inner">
    <div class="cta-copy">
      <Heading>{title}</Heading>
      <p>{body}</p>
    </div>
    <div class="btn-row cta-actions">
      <a class="btn btn-primary" href={primaryHref}>{primaryLabel}</a>
      <a class="btn btn-ghost" href={secondaryHref ?? callHref()}>
        {secondaryLabel ?? fallbackSecondaryLabel}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band { padding-block: var(--space-xl); }
  .cta-inner {
    display: grid;
    gap: var(--space-m);
    align-items: center;
  }
  .cta-copy { max-width: 52ch; }
  .cta-copy p { margin-top: var(--space-xs); }
  .cta-actions { flex-shrink: 0; }

  @media (min-width: 56rem) {
    .cta-inner { grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-xl); }
  }
</style>
