---
import { defaultLang, type Lang } from '../i18n';
import { processSteps, sectionCopy } from '../i18n/content';

export interface Step {
  title: string;
  body: string;
}

export interface Props {
  lang?: Lang;
  eyebrow?: string;
  title?: string;
  intro?: string;
  steps?: Step[];
  headingLevel?: 'h2' | 'h3';
}

const { lang = defaultLang, ...rest } = Astro.props;
const copy = sectionCopy[lang];
const {
  eyebrow = copy.processEyebrow,
  title = copy.processTitle,
  intro,
  steps = processSteps[lang],
  headingLevel = 'h2',
} = rest;

const Heading = headingLevel;
---

<section class="section process">
  <div class="shell">
    <div class="section-head">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <Heading>{title}</Heading>
      {intro && <p class="lede" style="margin-top:var(--space-s)">{intro}</p>}
    </div>

    <ol class="steps">
      {
        steps.map((step, index) => (
          <li class="step">
            <span class="step-num" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14.5rem), 1fr));
    counter-reset: step;
  }

  .step {
    padding-top: var(--space-s);
    border-top: 2px solid var(--line-strong);
  }

  .step-num {
    display: block;
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.06em;
    margin-bottom: 0.4rem;
  }

  .step-title { font-size: var(--step-1); }
  .step-body { margin-top: 0.4rem; color: var(--ink-soft); font-size: 0.97rem; }

  .section-dark .step { border-top-color: color-mix(in srgb, var(--ink-inverse) 25%, transparent); }
</style>
