---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site, absolute } from '../config/site';
import type { Crumb } from '../components/Breadcrumbs.astro';

export interface Props {
  /** Full <title>. Keep it under ~60 characters so it survives the SERP. */
  title: string;
  /** Meta description, written for click-through as well as intent. ~150–160 chars. */
  description: string;
  /** Site-relative path of this page, always with a trailing slash. */
  path: string;
  /** Breadcrumb trail; omit on the home page. */
  crumbs?: Crumb[];
  /** Site-relative path to the social share image. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  /** Extra JSON-LD blocks for this page. */
  schema?: Record<string, unknown>[];
  /** Set true only where a page genuinely should stay out of the index. */
  noindex?: boolean;
  /** Preload a hero image (the LCP candidate) with a responsive srcset. */
  preload?: { srcset: string; sizes: string; type?: string };
  bodyClass?: string;
}

const {
  title,
  description,
  path,
  crumbs,
  ogImage = '/og/machin-solutions-og.jpg',
  ogImageAlt = 'A modern aluminium pergola over a South Florida pool deck, built by Machin Solutions.',
  ogType = 'website',
  schema = [],
  noindex = false,
  preload,
  bodyClass,
} = Astro.props;

const canonical = absolute(path);
const ogImageUrl = absolute(ogImage);
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#161a18" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Headings fall back to a serif stack, so the webfont must not block first
        paint. media="print" makes the browser fetch it at low priority and the
        onload flip applies it; <noscript> covers scripting-off. */}
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&display=swap"
      media="print"
      onload="this.media='all';this.onload=null"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&display=swap"
      />
    </noscript>

    {
      preload && (
        <link
          rel="preload"
          as="image"
          imagesrcset={preload.srcset}
          imagesizes={preload.sizes}
          type={preload.type ?? 'image/avif'}
          fetchpriority="high"
        />
      )
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {
      schema.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header currentPath={path} />
    {crumbs && crumbs.length > 0 && <Breadcrumbs crumbs={crumbs} />}
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyCta />
  </body>
</html>
